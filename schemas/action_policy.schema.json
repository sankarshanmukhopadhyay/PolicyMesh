{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policymesh.example/schemas/action_policy.schema.json",
  "title": "PolicyMesh Action Policy",
  "type": "object",
  "required": ["format", "policy_id", "version", "title", "rules"],
  "properties": {
    "format": {"const": "policymesh.action_policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "description", "source", "path", "operator", "on_fail", "reason_code"],
        "properties": {
          "rule_id": {"type": "string"},
          "description": {"type": "string"},
          "source": {"enum": ["request", "evidence", "authority_context"]},
          "path": {"type": "string"},
          "operator": {"enum": ["eq", "neq", "lt", "lte", "gt", "gte", "in", "not_in", "exists"]},
          "expected": {},
          "expected_path": {"type": "string"},
          "on_fail": {"enum": ["deny", "defer"]},
          "reason_code": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
