{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policymesh.example/schemas/action_policy.schema.json",
  "title": "PolicyMesh Action Policy",
  "type": "object",
  "required": [
    "policy_id",
    "version",
    "title",
    "rules"
  ],
  "properties": {
    "format": {
      "const": "policymesh.action_policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "description",
          "source",
          "path",
          "operator",
          "reason_code"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "source": {
            "enum": [
              "request",
              "evidence",
              "authority_context"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[^.]+(\\.[^.]+)*$"
          },
          "operator": {
            "enum": [
              "eq",
              "neq",
              "lt",
              "lte",
              "gt",
              "gte",
              "in",
              "not_in",
              "exists"
            ]
          },
          "expected": {},
          "expected_path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(request|evidence|authority_context)\\.[^.]+(\\.[^.]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "on_fail": {
            "enum": [
              "deny",
              "defer"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "exists"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "null"
                },
                "expected_path": {
                  "type": "null"
                }
              }
            },
            "else": {
              "oneOf": [
                {
                  "required": [
                    "expected"
                  ],
                  "properties": {
                    "expected": {
                      "not": {
                        "type": "null"
                      }
                    },
                    "expected_path": {
                      "type": "null"
                    }
                  }
                },
                {
                  "required": [
                    "expected_path"
                  ],
                  "properties": {
                    "expected_path": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "in",
                    "not_in"
                  ]
                },
                "expected_path": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "array"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "lt",
                    "lte",
                    "gt",
                    "gte"
                  ]
                },
                "expected_path": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "number"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
