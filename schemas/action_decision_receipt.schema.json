{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policymesh.example/schemas/action_decision_receipt.schema.json",
  "title": "PolicyMesh Action Decision Receipt",
  "type": "object",
  "required": [
    "format",
    "receipt_id",
    "decided_at",
    "decision",
    "request_id",
    "action",
    "policy_id",
    "policy_version",
    "policy_hash",
    "request_digest",
    "evidence_digest",
    "authority_context_digest",
    "reason_codes",
    "evaluations"
  ],
  "properties": {
    "format": {
      "const": "policymesh.action_decision_receipt.v1"
    },
    "receipt_id": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "permit",
        "deny",
        "defer"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "principal": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_hash": {
      "type": "string"
    },
    "request_digest": {
      "type": "string"
    },
    "evidence_digest": {
      "type": "string"
    },
    "authority_context_digest": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "description",
          "result",
          "operator",
          "on_fail",
          "reason_code"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "actual": {},
          "expected": {},
          "operator": {
            "enum": [
              "eq",
              "neq",
              "lt",
              "lte",
              "gt",
              "gte",
              "in",
              "not_in",
              "exists"
            ]
          },
          "on_fail": {
            "enum": [
              "deny",
              "defer"
            ]
          },
          "reason_code": {
            "type": "string"
          },
          "failure_kind": {
            "enum": [
              null,
              "missing_operand",
              "null_operand",
              "invalid_operand",
              "constraint_failed"
            ]
          }
        }
      }
    },
    "evaluation_semantics": {
      "enum": [
        "policymesh.action_evaluation.v2",
        null
      ]
    }
  },
  "additionalProperties": false
}
